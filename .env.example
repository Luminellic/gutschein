# Kopieren nach .env und anpassen. Die Datei .env nie ins Git einchecken.

# Öffentliche Adresse ohne Schrägstrich am Ende (für Links in Mails, QR-Codes, Stripe-Rücksprung)
APP_URL=http://localhost:8000
# Nur nötig, wenn die App in einem Unterordner läuft, z.B. /gutscheine
APP_BASE_PATH=
APP_DEBUG=false
APP_TIMEZONE=Europe/Zurich

# Datenbank (MySQL 8 / MariaDB 10.6+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gutschein
DB_USER=root
DB_PASS=
# Nur für lokale Vorführungen ohne MySQL: DB_DRIVER=sqlite und DB_DATABASE=storage/demo.sqlite
DB_DATABASE=

# Zahlung: demo (simuliert) oder stripe
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leer = Zahlarten gemäss Stripe-Dashboard. Oder fest vorgeben, z.B. card,twint
STRIPE_PAYMENT_METHODS=

# E-Mail: log (nur Protokoll), smtp oder mail
MAIL_DRIVER=log
MAIL_FROM=gutscheine@example.ch
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
